{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-operacao",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "big-operacao", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "observability": {"enabled": true},
  "limits": {"cpu_ms": 30000},
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"FARM_WORKER_SERVICE": "big-operacao", "APP_ORIGIN": "", "CLOUDFLARE_ACCOUNT_ID": ""}
}

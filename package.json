{
  "name": "big-operacao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "build": "node scripts/build-vercel.mjs",
    "deploy:farm": "wrangler deploy --config wrangler.farm.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
